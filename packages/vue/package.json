{
  "name": "@xyj2156/vue-loading",
  "version": "0.1.0",
  "description": "Vue components for @xyj2156/css-loading",
  "type": "module",
  "main": "./dist/vue-loading.umd.cjs",
  "module": "./dist/vue-loading.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-loading.js",
      "require": "./dist/vue-loading.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "@xyj2156/css-loading": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
