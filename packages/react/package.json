{
  "name": "@xyj2156/react-loading",
  "version": "0.1.0",
  "description": "React components for @xyj2156/css-loading",
  "type": "module",
  "main": "./dist/react-loading.umd.cjs",
  "module": "./dist/react-loading.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-loading.js",
      "require": "./dist/react-loading.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@xyj2156/css-loading": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.0"
  }
}
